{
  "name": "cutemarkets-cookbook",
  "private": true,
  "version": "0.1.0",
  "description": "Runnable recipes for using CuteMarkets options data in Python and TypeScript.",
  "type": "module",
  "scripts": {
    "ts:options-chain-scanner": "tsx typescript/options-chain-scanner/scanner.ts",
    "ts:earnings-implied-move": "tsx typescript/earnings-implied-move/earnings_implied_move.ts",
    "check:typescript": "tsc -p tsconfig.json --noEmit",
    "check:python": "python3 scripts/check_python_recipes.py",
    "test": "npm run check:typescript && npm run check:python"
  },
  "dependencies": {
    "cutemarkets-typescript": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
